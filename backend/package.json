{
  "name": "subligol-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de Subligol (INFB8091 Desempeño de Sistemas, UTEM)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../.env scripts/migrar.js",
    "seed": "node --env-file-if-exists=../.env seeds/seed.js"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  }
}
