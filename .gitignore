# Archivos temporales del editor Kate
*.kate-swp

# Pruebas de carga: los datos crudos son pesados (se guardan fuera del repo);
# los reportes HTML, los resúmenes JSON y los metadatos sí se versionan.
carga/resultados/**/*.csv
carga/resultados/**/*.csv.gz
carga/resultados/**/*.ndjson
carga/resultados/**/*.navegador.log
# El registro de CPU del generador sí es evidencia (la regla *.log de arriba lo excluiría).
!carga/resultados/**/*.generador.log
# Métricas del servidor exportadas de Prometheus: sí se versionan (son livianas y son evidencia).
!carga/resultados/**/*.servidor.csv
!carga/resultados/**/*.rutas.csv
!carga/resultados/**/*.consultas.csv
