# Frontend: URL base de la API propia. Vacío = '/api' en el mismo origen
# (en desarrollo, el proxy de vite.config.js la reenvía a http://localhost:3000).
# Si apunta a otro origen, el backend necesitaría habilitar CORS.
VITE_API_URL=

# Google Analytics 4 (GA4) - Asignatura Desempeño de Sistemas UTEM
# ID de medición del flujo web (G-XXXXXXXXXX). Vacío = GA4 deshabilitado
# (los eventos solo se muestran en la consola en desarrollo).
# Recuerda invitar a j.aranda@utem.cl en la consola de Google Analytics con rol de Lector
VITE_GA_MEASUREMENT_ID=
# debug_mode para ver los eventos en DebugView. En `npm run dev` siempre está activo;
# true lo activa también en el build de producción (por ejemplo, para la demo).
VITE_GA_DEBUG=false

# ------------------------------------------------------------------
# Backend (API Express + PostgreSQL en Docker)
# ------------------------------------------------------------------
POSTGRES_USER=subligol
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=subligol
# Puertos expuestos en el equipo (cambiar si ya están ocupados)
POSTGRES_PUERTO_HOST=5432
API_PUERTO_HOST=3000
# Conexión usada por `cd backend && npm run dev` (fuera de Docker)
DATABASE_URL=postgres://subligol:cambiar-esta-clave@localhost:5432/subligol
# Tamaño máximo del pool de conexiones a PostgreSQL
PG_POOL_MAX=10
# Contraseñas de los usuarios creados por `npm run seed`
# (test001..test200@ejemplo.cl comparten la de clientes; admin@subligol.cl usa la de admin)
SEED_CONTRASENA_CLIENTES=cambiar-clave-clientes
SEED_CONTRASENA_ADMIN=cambiar-clave-admin
# Autenticación (JWT HS256). Obligatorio en producción, mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRETO=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Duración del token (formato de jsonwebtoken: 30m, 2h, 1d...)
JWT_EXPIRACION=2h
# Parámetros de argon2id (vacío = valores por defecto: 65536 KiB, 3 iteraciones, paralelismo 4).
# El hash es caro en CPU y memoria: el login es un cuello de botella a medir en la Fase 2.
ARGON2_MEMORIA_KIB=
ARGON2_ITERACIONES=
ARGON2_PARALELISMO=
# Pago simulado en el checkout (medio_pago "mock", sin llamar a Transbank).
# true en local y para las pruebas de carga (guía, sección 5.3: bajo carga nunca
# se llama al sandbox de un tercero). En un deploy real debe ir en false.
PAGO_MOCK=true

# ------------------------------------------------------------------
# Monitoreo (Prometheus + Grafana)
# ------------------------------------------------------------------
# Contraseña del usuario "admin" de Grafana (http://127.0.0.1:3001).
# Se deja vacío a propósito: docker compose no arranca hasta definirla.
GRAFANA_CONTRASENA=
# Puertos en el equipo (solo 127.0.0.1; cambiar si ya están ocupados)
PROMETHEUS_PUERTO_HOST=9090
GRAFANA_PUERTO_HOST=3001
# Puerto interno de GET /metrics de la API (no se publica fuera de Docker)
METRICAS_PUERTO=9464

# ------------------------------------------------------------------
# Producción (docker-compose.prod.yml, en la VM)
# ------------------------------------------------------------------
# Dominio público: Caddy obtiene el certificado HTTPS automáticamente.
# Con DOMINIO=localhost usa un certificado interno (pruebas locales).
DOMINIO=
