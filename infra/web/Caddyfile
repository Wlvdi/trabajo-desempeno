# Caddy: HTTPS automático (Let's Encrypt) para DOMINIO, proxy de /api a la
# API y la tienda (SPA) para todo lo demás.
# Con DOMINIO=localhost usa un certificado interno (pruebas locales).
{
	email {$CORREO_ACME}
}

{$DOMINIO} {
	encode zstd gzip

	# API: /api/* → contenedor api (puerto interno 3000).
	# /metrics NO se expone: vive en otro puerto (9464) que solo lee Prometheus.
	handle /api/* {
		reverse_proxy api:3000
	}

	# Tienda: archivos del build y, para cualquier ruta de la SPA, index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Los archivos de /assets llevan hash en el nombre: se pueden cachear un año.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
